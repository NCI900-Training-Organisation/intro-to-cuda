#!/bin/bash
#PBS -N cuda15
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Run make separately. Submit from job-script: qsub 15-profiling.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
cd "$PBS_O_WORKDIR/../exercises/15-profiling"

nsys profile --stats=true --trace=cuda,nvtx,osrt \
    --cuda-memory-usage=true --force-overwrite=true \
    -o vector_add_unified_profile ./vector_add_unified

#!/bin/bash
#PBS -N 05-thread-timing
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Build separately with CMake in exercises/build. Submit from job-script: qsub 05-thread-timing.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
cd "$PBS_O_WORKDIR/../exercises/05-warps"

"../build/ex-05-warps-thread-timing" thread-timestamps.csv
head -n 17 thread-timestamps.csv

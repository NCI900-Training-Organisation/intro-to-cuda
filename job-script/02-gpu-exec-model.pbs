#!/bin/bash
#PBS -N 02-gpu-exec-model
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Run make separately. Submit from job-script: qsub 02-gpu-exec-model.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
module load python3/3.11.0
cd "$PBS_O_WORKDIR/../exercises/02-gpu-exec-model"

./print_launch
./print_global_index
./double_thread_index
./double_global_index
# grid_x grid_y block_x block_y
./thread_indexing 2 2 2 2 threads.csv
python3 draw_indices.py 2 2 2 2 --csv threads.csv --terminal --output threads.svg

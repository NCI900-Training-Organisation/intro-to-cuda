#!/bin/bash
#PBS -N 12-cuda-graphs
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Build separately with CMake in exercises/build. Submit from job-script: qsub 12-cuda-graphs.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
cd "$PBS_O_WORKDIR/../exercises/12-cuda-graphs"

"../build/ex-12-cuda-graphs-vector-add-async"
"../build/ex-12-cuda-graphs-compare-graphs"
"../build/ex-12-cuda-graphs-custom-graph"
"../build/ex-12-cuda-graphs-update-node-args"

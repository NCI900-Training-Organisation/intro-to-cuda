#!/bin/bash
#PBS -N 01-performance-basics
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Build separately with CMake in exercises/build. Submit from job-script: qsub 01-performance-basics.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
cd "$PBS_O_WORKDIR/../exercises/01-performance-basics"

module load intel-mkl/2024.2.1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
"../build/ex-01-performance-basics-perf-gemm-intelmkl"
"../build/ex-01-performance-basics-perf-gemm-cuda"

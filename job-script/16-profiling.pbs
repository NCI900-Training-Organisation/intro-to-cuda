#!/bin/bash
#PBS -N 16-profiling
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Build separately with CMake in exercises/build. Submit from job-script: qsub 16-profiling.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
cd "$PBS_O_WORKDIR/../exercises/16-profiling"

nsys profile --stats=true --trace=cuda,nvtx,osrt \
    --cuda-memory-usage=true --force-overwrite=true \
    -o vector-add-unified-profile "../build/ex-16-profiling-vector-add-unified"

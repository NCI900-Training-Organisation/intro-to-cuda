#!/bin/bash
#PBS -N 03-gpu-exec-model
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l walltime=00:15:00
#PBS -l ncpus=12,ngpus=1,mem=48GB
#PBS -l storage=scratch/vp91
#PBS -l wd
#PBS -j oe

# Build separately with CMake in exercises/build. Submit from job-script: qsub 03-gpu-exec-model.pbs
set -e
module load gcc/14.2.0 cuda/12.9.0
module load python3/3.11.0
cd "$PBS_O_WORKDIR/../exercises/03-gpu-exec-model"

"../build/ex-03-gpu-exec-model-01-print-thread-index"
"../build/ex-03-gpu-exec-model-02-double-thread-index"
"../build/ex-03-gpu-exec-model-03-print-global-index"
"../build/ex-03-gpu-exec-model-04-double-global-index"
# grid_x grid_y block_x block_y
"../build/ex-03-gpu-exec-model-05-thread-indexing" 2 2 2 2 threads.csv
python3 05-thread-indexing/draw-indices.py 2 2 2 2 --csv threads.csv --terminal --output threads.svg
